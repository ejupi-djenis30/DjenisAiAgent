# Copy to .env. Never commit the populated file.

# Local inference is mandatory. There are no provider API keys or cloud fallbacks.
# `ollama` expects the native Ollama API. `openai-compatible` expects a local
# OpenAI-compatible server whose base URL ends in /v1 (for example llama.cpp).
DJENIS_LOCAL_LLM_BACKEND="ollama"
DJENIS_LOCAL_LLM_ENDPOINT="http://127.0.0.1:11434"
DJENIS_LOCAL_LLM_MODEL="qwen3-vl:8b"
# Recommended after the first trusted provisioning: pin the full lowercase SHA-256
# returned by Ollama /api/tags. Leave empty only until that artifact is established.
DJENIS_LOCAL_LLM_EXPECTED_DIGEST=""
# 64K preserves long objectives, UI state, and verification history. KV-cache memory
# grows with this value; lower it deliberately only when hardware cannot sustain 64K.
DJENIS_LOCAL_LLM_CONTEXT_TOKENS="65536"
DJENIS_LOCAL_LLM_VISION="true"
DJENIS_LOCAL_LLM_KEEP_ALIVE="10m"
DJENIS_LOCAL_LLM_SEED="0"
DJENIS_LOCAL_LLM_RESPONSE_MAX_BYTES="1048576"
DJENIS_LOCAL_LLM_IMAGE_MAX_BYTES="5242880"
DJENIS_LOCAL_LLM_VISION_MAX_DIMENSION="1600"
DJENIS_LOCAL_LLM_VISION_QUALITY="80"

# The selected model must already exist in the local runtime. DjenisAiAgent never
# downloads a model during startup or falls back to a remote provider.

# Safe-by-default capability policy: observe | interact | system
DJENIS_PERMISSION_TIER="observe"
DJENIS_ALLOWED_PATHS="."
# Comma-separated absolute executable paths. The model may request a unique basename,
# but the host always launches the configured path and never searches PATH.
DJENIS_ALLOWED_APPLICATIONS=""
DJENIS_ALLOWED_SHELL_COMMANDS=""
# Exact private/local hosts that browser tools may access intentionally.
# Keep empty to allow only hosts resolving exclusively to public IP addresses.
DJENIS_ALLOWED_URL_HOSTS=""

# System-tier tools require this second, explicit opt-in. Leave disabled unless
# you understand that shell, file-write, app-launch, and screenshot-save tools
# can change or disclose data on the machine.
DJENIS_CONFIRM_DANGEROUS_ACTIONS="false"

# Required only for --web. Generate a unique value of at least 24 characters,
# for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
DJENIS_WEB_AUTH_TOKEN=""
DJENIS_WEB_HOST="127.0.0.1"
DJENIS_WEB_ALLOWED_ORIGINS=""
DJENIS_WEB_SESSION_TTL="3600"
DJENIS_WEB_RATE_LIMIT_PER_MINUTE="60"
DJENIS_WEB_LOGIN_RATE_LIMIT_PER_MINUTE="10"
DJENIS_WEB_UPLOAD_MAX_BYTES="5242880"
DJENIS_WEB_SESSION_COOKIE_SECURE="false"
DJENIS_WEB_MAX_SESSIONS="32"
DJENIS_WEB_MAX_CONNECTIONS="8"
DJENIS_WEB_SOCKET_SEND_TIMEOUT="5"
DJENIS_WEB_STREAM_MAX_CLIENTS="2"
DJENIS_WEB_TRANSCRIPTION_MAX_CONCURRENCY="1"
DJENIS_WEB_TRANSCRIPTION_TIMEOUT="60"

# Runtime and browser connection
DJENIS_RUNTIME_MODE="auto"
DJENIS_PROFILE="default"
DJENIS_BROWSER_DEBUGGING_HOST="127.0.0.1"
DJENIS_BROWSER_DEBUGGING_PORT="9222"
# SELENIUM_REMOTE_URL="http://localhost:4444/wd/hub"

# Agent limits
DJENIS_MAX_LOOP_TURNS="50"
DJENIS_ACTION_TIMEOUT="45"
DJENIS_API_TIMEOUT="120"
DJENIS_API_MAX_RETRIES="3"
DJENIS_API_RETRY_DELAY="2.0"
DJENIS_TASK_TIMEOUT="900"
DJENIS_SHELL_TIMEOUT="60"
DJENIS_SHELL_OUTPUT_MAX_BYTES="1048576"
DJENIS_COMMAND_MAX_CHARS="4096"
DJENIS_OBSERVATION_MAX_CHARS="16384"
DJENIS_PROMPT_HISTORY_MAX_CHARS="65536"
DJENIS_UI_TREE_MAX_CHARS="65536"
DJENIS_TOOL_ARGUMENT_MAX_CHARS="16384"
DJENIS_MAX_REPEATED_ACTIONS="2"
DJENIS_COMPLETION_EVIDENCE_MIN_CHARS="12"
DJENIS_SNAPSHOT_DEPTH="4"
DJENIS_LOCATOR_CACHE_SIZE="64"
DJENIS_CLIPBOARD_MAX_BYTES="1048576"
DJENIS_TEMPERATURE="0.0"
DJENIS_MAX_TOKENS="4096"

# Logging and capture
DJENIS_LOG_LEVEL="INFO"
DJENIS_VERBOSE_LOGGING="false"
DJENIS_ENABLE_AUDIT_LOG="true"
DJENIS_AUDIT_LOG_PATH="logs/agent-audit.jsonl"
DJENIS_AUDIT_LOG_MAX_BYTES="10485760"
DJENIS_SCREENSHOT_INTERVAL="0.1"
DJENIS_SCREENSHOT_QUALITY="100"
DJENIS_SCREENSHOT_FORMAT="PNG"
DJENIS_STREAM_RESIZE_FACTOR="1.0"
DJENIS_STREAM_MAX_FPS="15"
DJENIS_STREAM_FRAME_QUALITY="80"
DJENIS_PERCEPTION_DOWNSCALE="1.0"

# Optional local transcription
DJENIS_LOCAL_TRANSCRIPTION="false"
DJENIS_VOSK_MODEL_PATH=""
DJENIS_TRANSCRIPTION_SAMPLE_RATE="16000"
